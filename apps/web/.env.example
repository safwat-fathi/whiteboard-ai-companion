# ── Web App Configuration (Next.js) ─────────────────────────────────────────
# Copy this file to .env.local (or .env) in apps/web.
#
# Backend Server API Base URL
# - Set to connect the web frontend to the backend server (enables remote boards,
#   WebSocket sync, library book viewer, and AI tutor chat dock).
# - Leave unset or empty to run in offline local mode (boards kept in browser IndexedDB only).
NEXT_PUBLIC_API_BASE=http://localhost:4000

