# ── AI Providers (Server-side only — never expose to browser) ──────────────
# Meta Model API key (all LLM chat, tool loop, vision, summaries & page OCR)
META_API_KEY=
META_API_BASE_URL=https://api.llama.com/compat/v1

# OpenRouter API key (used strictly for baai/bge-m3 embeddings & M0 benchmark scripts)
OPENROUTER_API_KEY=

# ── Active Models (Meta Model API defaults) ────────────────────────────────
# Also supports: Llama-3.3-70B-Instruct, Llama-3.2-90B-Vision-Instruct, Llama-3.2-11B-Vision-Instruct
# M0 S3 OpenRouter benchmarked baseline:
#   TUTOR_MODEL=anthropic/claude-haiku-5.5
#   TUTOR_MODEL_AR=google/gemini-3.8-flash
#   REVIEWER_MODEL=anthropic/claude-sonnet-5.5
#   CHEAP_MODEL=anthropic/claude-haiku-5.5
#   VISION_MODEL=google/gemini-3.8-flash
TUTOR_MODEL=Llama-4-Maverick-17B-128E-Instruct-FP8
TUTOR_MODEL_AR=Llama-4-Maverick-17B-128E-Instruct-FP8
TUTOR_FALLBACK_MODEL=Llama-4-Scout-17B-16E-Instruct-FP8
REVIEWER_MODEL=Llama-4-Maverick-17B-128E-Instruct-FP8
CHEAP_MODEL=Llama-4-Scout-17B-16E-Instruct-FP8
VISION_MODEL=Llama-4-Maverick-17B-128E-Instruct-FP8

# ── Embeddings (via OpenRouter /api/v1/embeddings) ─────────────────────────
EMBED_MODEL=baai/bge-m3
EMBED_DIMS=1024

# ── Server & Storage ───────────────────────────────────────────────────────
DATA_DIR=./data
PORT=4000
PUBLIC_ORIGIN=http://localhost:3000

# ── Guardrails & Budgets ───────────────────────────────────────────────────
MAX_STEPS=12
MAX_TURN_COST_USD=0.50
DAILY_BUDGET_USD=5
CHAPTER_STUFF_MAX_TOKENS=60000

# ── Testing ────────────────────────────────────────────────────────────────
TUTOR_STUB=0

