# ── AI Providers (Server-side only — never expose to browser) ──────────────
# Meta Model API key (all LLM chat, tool loop, vision, summaries & page OCR)
# (Also accepts MODEL_API_KEY as used in the meta-models/meta-model-cookbook)
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1

# OpenRouter API key (used strictly for baai/bge-m3 embeddings & M0 benchmark scripts)
OPENROUTER_API_KEY=

# ── Active Models (Meta Model API defaults) ────────────────────────────────
# api.meta.ai hosts Meta's Muse series (muse-spark-1.3, muse-spark-1.2, muse-wonder-1.0).
# (For open-weights Llama 4, use OpenRouter: meta-llama/llama-4-maverick, meta-llama/llama-4-scout)
# M0 S3 OpenRouter benchmarked baseline:
#   TUTOR_MODEL=anthropic/claude-haiku-5.5
#   TUTOR_MODEL_AR=google/gemini-3.8-flash
#   REVIEWER_MODEL=anthropic/claude-sonnet-5.5
#   CHEAP_MODEL=anthropic/claude-haiku-5.5
#   VISION_MODEL=google/gemini-3.8-flash
TUTOR_MODEL=muse-spark-1.3
TUTOR_MODEL_AR=muse-spark-1.3
TUTOR_FALLBACK_MODEL=muse-spark-1.3
REVIEWER_MODEL=muse-wonder-1.0
CHEAP_MODEL=muse-spark-1.3
VISION_MODEL=muse-spark-1.3

# ── Snapshot Adapter ───────────────────────────────────────────────────────
# Meta Model API rejects multipart/image file parts inside role:'tool' (HTTP 400).
# 'follow-up-user' attaches snapshots as a follow-up user message.
SNAPSHOT_ADAPTER=follow-up-user

# ── Embeddings (via OpenRouter /api/v1/embeddings) ─────────────────────────
EMBED_MODEL=baai/bge-m3
EMBED_DIMS=1024

# ── Server & Storage ───────────────────────────────────────────────────────
DATA_DIR=./data
PORT=4000
HOST=127.0.0.1
PUBLIC_ORIGIN=http://localhost:3000
# Set in apps/web's environment to use the server; unset = the editor keeps its board in this browser only (local mode).
# NEXT_PUBLIC_API_BASE=http://localhost:4000

# ── Guardrails & Budgets ───────────────────────────────────────────────────
MAX_STEPS=12
MAX_TURN_COST_USD=0.50
# Wall clock for one tutor turn. Muse takes 15-25 s per step, so raise this for long answers.
TURN_TIMEOUT_MS=120000
# USD per million tokens; leave unset while Meta publishes no price (turns are then unpriced, tokens are still counted).
# TUTOR_PRICE_IN_PER_M=
# TUTOR_PRICE_OUT_PER_M=
# low | medium | high, sent as reasoning_effort; leave unset for the model's default.
# TUTOR_REASONING_EFFORT=
DAILY_BUDGET_USD=5
CHAPTER_STUFF_MAX_TOKENS=60000

# ── Testing ────────────────────────────────────────────────────────────────
TUTOR_STUB=0
# 1 = the library uses offline stand-in providers (no Meta or OpenRouter calls): tests and the e2e gate only
# INGEST_STUB=1

